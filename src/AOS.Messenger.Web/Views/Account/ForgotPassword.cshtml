@model AOS.Messenger.Web.Controllers.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="w-full flex-1 min-h-[calc(100vh-140px)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-6 bg-surface-lowest dark:bg-[#1E1F23] p-8 rounded-2xl border border-outline-variant/30 shadow-xl">
        <div class="text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 text-primary mb-3">
                <span class="material-symbols-outlined text-3xl">key</span>
            </div>
            <h2 class="text-2xl font-bold font-headline text-on-surface dark:text-white">Reset Password</h2>
            <p class="text-sm text-secondary dark:text-gray-400 mt-1">Enter your account email to receive a password reset link</p>
        </div>

        @if (ViewData["Sent"] as bool? == true)
        {
            <div class="p-4 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 rounded-xl text-sm text-emerald-800 dark:text-emerald-200">
                If an account exists for that email, a password reset link has been dispatched. (Check server logs in development).
            </div>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post" class="space-y-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="text-xs text-error dark:text-red-400"></div>
                }

                <div>
                    <label asp-for="Email" class="block text-xs font-semibold text-on-surface dark:text-gray-300 uppercase tracking-wider mb-1.5"></label>
                    <input asp-for="Email" class="w-full px-4 py-2.5 bg-surface-low dark:bg-[#2A2B30] border border-outline-variant/40 rounded-xl text-sm text-on-surface dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary" placeholder="email@example.com" autofocus />
                    <span asp-validation-for="Email" class="text-xs text-error dark:text-red-400 mt-1 block"></span>
                </div>

                <button type="submit" class="w-full py-2.5 px-4 bg-primary text-white rounded-xl text-sm font-semibold hover:bg-primary/90 transition-all shadow-md">
                    Send Reset Link
                </button>
            </form>
        }

        <div class="text-center pt-2">
            <a asp-action="Login" class="text-xs text-primary font-semibold hover:underline">Back to Login</a>
        </div>
    </div>
</div>
