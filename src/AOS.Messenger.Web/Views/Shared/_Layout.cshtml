@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isChatIndex = string.Equals(currentController, "Chat", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isConversation = string.Equals(currentController, "Chat", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Conversation", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "A♡S Messenger")</title>

    <!-- Theme Initialization (Pre-Paint) -->
    <script src="~/js/theme-init.js" asp-append-version="true"></script>

    <!-- Compiled Tailwind CSS v4 -->
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />

    <!-- Warm Modern Messenger Design Theme Styles -->
    <link rel="stylesheet" href="~/css/stitch-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AOS.Messenger.Web.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="h-dvh h-screen w-full max-w-full overflow-hidden flex flex-col antialiased select-none bg-light-bg dark:bg-dark-bg text-light-textPrimary dark:text-dark-textPrimary font-sans box-border">
    <!-- Desktop App Window Header / Title Bar -->
    <header class="h-10 bg-[#F0E9DF] dark:bg-[#45433F] border-b border-[#E3DCD7] dark:border-[#5B5752] px-3 sm:px-4 flex items-center justify-between shrink-0 z-20 w-full max-w-full overflow-x-clip box-border">
        <div class="flex items-center gap-2 sm:gap-3 min-w-0 shrink-0">
            <!-- Window Controls (hidden on mobile) -->
            <div class="hidden sm:flex items-center gap-1.5 shrink-0">
                <span class="w-3 h-3 rounded-full bg-[#E5897A] border border-[#D77465] inline-block" title="Close"></span>
                <span class="w-3 h-3 rounded-full bg-[#E8C56E] border border-[#D5B055] inline-block" title="Minimize"></span>
                <span class="w-3 h-3 rounded-full bg-[#82B386] border border-[#6E9E72] inline-block" title="Maximize"></span>
            </div>
            <div class="hidden sm:block h-4 w-px bg-[#E3DCD7] dark:bg-[#5B5752] mx-0.5 sm:mx-1 shrink-0"></div>
            <a asp-controller="Chat" asp-action="Index" class="text-xs font-semibold text-[#6E6560] dark:text-[#C8C0BA] tracking-wide hover:text-[#2B2725] dark:hover:text-[#EEE7DF] transition-colors whitespace-nowrap shrink-0">
                A♡S Messenger
            </a>
        </div>

        <div class="flex items-center gap-2 sm:gap-3 text-xs font-medium text-[#6E6560] dark:text-[#C8C0BA] shrink-0">
            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-2 text-xs shrink-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Chat" asp-action="Index" class="hover:text-[#2B2725] dark:hover:text-[#EEE7DF] transition-colors">Chat</a>
                    <span class="text-[#E3DCD7] dark:text-[#5B5752]">/</span>
                    <a asp-controller="Settings" asp-action="Index" class="hover:text-[#2B2725] dark:hover:text-[#EEE7DF] transition-colors">Settings</a>
                    <span class="text-[#E3DCD7] dark:text-[#5B5752]">/</span>
                    <a asp-controller="Profile" asp-action="Index" class="hover:text-[#2B2725] dark:hover:text-[#EEE7DF] transition-colors">Profile</a>
                    <span class="text-[#E3DCD7] dark:text-[#5B5752]">/</span>
                    <a asp-controller="Account" asp-action="Sessions" class="hover:text-[#2B2725] dark:hover:text-[#EEE7DF] transition-colors">Sessions</a>
                    <span class="text-[#E3DCD7] dark:text-[#5B5752]">/</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        <button type="submit" class="hover:text-error transition-colors cursor-pointer">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="text-primary hover:underline font-semibold">Login</a>
                }
            </nav>

            <div class="h-4 w-px bg-[#E3DCD7] dark:bg-[#5B5752] mx-1 hidden md:block shrink-0"></div>

            <!-- Theme Switcher -->
            <button id="themeToggleBtn" data-theme-toggle type="button" class="flex items-center gap-1 bg-[#FFFFFF]/80 dark:bg-[#514D49] hover:bg-white dark:hover:bg-[#5B5752] px-2 py-0.5 rounded border border-[#E3DCD7] dark:border-[#5B5752] text-[#6E6560] dark:text-[#EEE7DF] transition-colors cursor-pointer shrink-0" title="Toggle Light / Dark Theme" aria-label="Toggle theme" aria-pressed="false">
                <span id="themeToggleIcon" class="material-symbols-outlined text-[15px]">dark_mode</span>
            </button>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- Connection Status Indicator -->
                <div class="flex items-center gap-1.5 bg-[#FFFFFF]/80 dark:bg-[#514D49] px-2 sm:px-2.5 py-1 rounded border border-[#E3DCD7] dark:border-[#5B5752] shrink-0" id="connectionStatusIndicator">
                    <span class="w-2 h-2 rounded-full bg-[#6F9473]" id="connectionStatusDot"></span>
                    <span class="text-[#2B2725] dark:text-[#EEE7DF] font-medium text-xs" id="connectionStatusText">Connected</span>
                </div>
            }

            <!-- Mobile Nav Menu Toggle Button -->
            <button type="button"
                    data-mobile-nav-toggle
                    aria-expanded="false"
                    aria-label="Open navigation menu"
                    class="md:hidden flex items-center justify-center p-1.5 rounded border border-[#E3DCD7] dark:border-[#5B5752] bg-[#FFFFFF]/80 dark:bg-[#514D49] text-[#6E6560] dark:text-[#EEE7DF] hover:bg-white dark:hover:bg-[#5B5752] transition-colors cursor-pointer shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>
    </header>

    <!-- Collapsible Mobile Navigation Drawer -->
    <div data-mobile-nav-menu class="hidden md:hidden absolute top-10 left-0 right-0 z-50 bg-[#F0E9DF] dark:bg-[#45433F] border-b border-[#E3DCD7] dark:border-[#5B5752] shadow-lg px-4 py-3 flex flex-col gap-2 text-sm font-medium">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Chat" asp-action="Index" class="hover:text-[#2B2725] dark:hover:text-[#EEE7DF] transition-colors py-1">Chat</a>
            <a asp-controller="Settings" asp-action="Index" class="hover:text-[#2B2725] dark:hover:text-[#EEE7DF] transition-colors py-1">Settings</a>
            <a asp-controller="Profile" asp-action="Index" class="hover:text-[#2B2725] dark:hover:text-[#EEE7DF] transition-colors py-1">Profile</a>
            <a asp-controller="Account" asp-action="Sessions" class="hover:text-[#2B2725] dark:hover:text-[#EEE7DF] transition-colors py-1">Sessions</a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="pt-1 border-t border-[#E3DCD7] dark:border-[#5B5752]">
                <button type="submit" class="hover:text-error transition-colors cursor-pointer text-left w-full py-1">Logout</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="text-primary hover:underline font-semibold py-1">Login</a>
        }
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="flex flex-1 min-h-0 overflow-hidden">
            <div id="app-sidebar-pane" class="@(isChatIndex ? "w-full md:w-80 md:shrink-0 flex" : "hidden md:flex md:w-80 md:shrink-0") h-full">
                @await Component.InvokeAsync("ConversationSidebar")
            </div>
            <main id="app-main-pane" class="@(isChatIndex ? "hidden md:flex" : "flex") flex-1 w-full min-w-0 min-h-0 h-full @(isConversation ? "overflow-hidden" : "overflow-y-auto") flex-col">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="flex-1 w-full min-w-0 min-h-0 h-full overflow-y-auto flex flex-col">
            @RenderBody()
        </main>
    }

    <!-- Core Scripts -->
    <script type="module" src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true && !isChatIndex && !isConversation)
    {
        <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    }
    <script type="module" src="~/js/sidebar.js" asp-append-version="true"></script>
    <script type="module" src="~/js/mobile-nav.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
