@model AOS.Messenger.Web.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="w-full flex-1 min-h-[calc(100vh-140px)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-surface-lowest dark:bg-[#1E1F23] p-8 rounded-2xl border border-outline-variant/30 shadow-xl">
        <div class="text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 text-primary mb-3">
                <span class="material-symbols-outlined text-3xl">person_add</span>
            </div>
            <h2 class="text-2xl font-bold font-headline text-on-surface dark:text-white">Create your account</h2>
            <p class="text-sm text-secondary dark:text-gray-400 mt-1">Join AOS Messenger</p>
        </div>

        <form asp-action="Register" method="post" class="mt-6 space-y-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="text-xs text-error dark:text-red-400 bg-error-container/20 p-2.5 rounded-lg"></div>
            }

            <div>
                <label asp-for="UserName" class="block text-xs font-semibold text-on-surface dark:text-gray-300 uppercase tracking-wider mb-1.5"></label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-xl">alternate_email</span>
                    <input asp-for="UserName" class="w-full pl-10 pr-4 py-2.5 bg-surface-low dark:bg-[#2A2B30] border border-outline-variant/40 rounded-xl text-sm text-on-surface dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="unique_username" autofocus />
                </div>
                <p class="text-[11px] text-gray-500 mt-1">Note: Username cannot be changed after registration.</p>
                <span asp-validation-for="UserName" class="text-xs text-error dark:text-red-400 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-on-surface dark:text-gray-300 uppercase tracking-wider mb-1.5"></label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-xl">mail</span>
                    <input asp-for="Email" class="w-full pl-10 pr-4 py-2.5 bg-surface-low dark:bg-[#2A2B30] border border-outline-variant/40 rounded-xl text-sm text-on-surface dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="email@example.com" />
                </div>
                <p class="text-[11px] text-gray-500 mt-1">Note: Email cannot be changed after registration.</p>
                <span asp-validation-for="Email" class="text-xs text-error dark:text-red-400 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="DisplayName" class="block text-xs font-semibold text-on-surface dark:text-gray-300 uppercase tracking-wider mb-1.5"></label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-xl">badge</span>
                    <input asp-for="DisplayName" class="w-full pl-10 pr-4 py-2.5 bg-surface-low dark:bg-[#2A2B30] border border-outline-variant/40 rounded-xl text-sm text-on-surface dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="Your Display Name" />
                </div>
                <span asp-validation-for="DisplayName" class="text-xs text-error dark:text-red-400 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-xs font-semibold text-on-surface dark:text-gray-300 uppercase tracking-wider mb-1.5"></label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-xl">lock</span>
                    <input asp-for="Password" class="w-full pl-10 pr-4 py-2.5 bg-surface-low dark:bg-[#2A2B30] border border-outline-variant/40 rounded-xl text-sm text-on-surface dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="Min. 8 characters" />
                </div>
                <span asp-validation-for="Password" class="text-xs text-error dark:text-red-400 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-semibold text-on-surface dark:text-gray-300 uppercase tracking-wider mb-1.5"></label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-xl">lock_reset</span>
                    <input asp-for="ConfirmPassword" class="w-full pl-10 pr-4 py-2.5 bg-surface-low dark:bg-[#2A2B30] border border-outline-variant/40 rounded-xl text-sm text-on-surface dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="••••••••" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-xs text-error dark:text-red-400 mt-1 block"></span>
            </div>

            <button type="submit" class="w-full py-2.5 px-4 bg-primary text-white rounded-xl text-sm font-semibold hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-all shadow-md mt-2">
                Create Account
            </button>
        </form>

        <div class="text-center pt-2 border-t border-outline-variant/20">
            <p class="text-xs text-secondary dark:text-gray-400">
                Already have an account?
                <a asp-action="Login" class="text-primary font-semibold hover:underline">Sign in</a>
            </p>
        </div>
    </div>
</div>
