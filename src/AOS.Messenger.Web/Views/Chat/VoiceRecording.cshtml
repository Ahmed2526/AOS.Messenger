@{
    ViewData["Title"] = "Voice Recording - A♡S Messenger";
}

<!-- RIGHT PANE: Active Conversation Area & Voice Recording -->
<div class="flex-1 h-full min-h-full w-full flex flex-col bg-[#F8F6F3] dark:bg-[#302F2C] min-w-0 overflow-hidden relative">
    <!-- Top Chat Header -->
    <div class="h-14 px-5 bg-[#FFFFFF] dark:bg-[#3A3835] border-b border-[#E3DCD7] dark:border-[#514D48] flex items-center justify-between flex-shrink-0 z-10 shadow-2xs">
        <div class="flex items-center gap-3">
            <div class="relative">
                <div class="w-9 h-9 rounded-full bg-[#B3929D]/20 dark:bg-[#B3929D]/25 text-[#B3929D] border border-[#B3929D]/40 dark:border-[#B3929D]/50 font-bold text-xs flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">person</span>
                </div>
                <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-[#6F9473] border-2 border-[#FFFFFF] dark:border-[#3A3835]"></span>
            </div>
            <div>
                <div class="flex items-center gap-1.5">
                    <h2 class="text-sm font-bold text-[#2B2725] dark:text-[#F0E9E2] leading-tight">Conversation</h2>
                </div>
                <div class="flex items-center gap-1.5 text-[11px] text-[#6F9473] font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#6F9473]"></span>
                    <span>Direct conversation • Voice Note</span>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-1">
            <button type="button" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors" title="Search in conversation">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </button>
            <button type="button" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors" title="Audio Call">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </button>
            <a asp-controller="Profile" asp-action="Index" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors" title="Conversation Details">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </a>
            <div class="h-4 w-px bg-[#E3DCD7] dark:bg-[#514D48] mx-1"></div>
            <a asp-controller="Chat" asp-action="ContextMenu" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors" title="More Actions">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </a>
        </div>
    </div>

    <!-- Clean Empty State Area for Voice Recording -->
    <div class="flex-1 overflow-y-auto custom-scroll p-8 flex flex-col justify-center items-center text-center select-none">
        <div class="max-w-md flex flex-col items-center">
            <div class="w-16 h-16 rounded-2xl bg-[#FFFFFF] dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] flex items-center justify-center mb-4 shadow-sm text-[#B3929D]">
                <span class="material-symbols-outlined text-[32px]">mic</span>
            </div>
            <h3 class="text-base font-bold text-[#2B2725] dark:text-[#F0E9E2] mb-1">
                Voice Recording
            </h3>
            <p class="text-xs text-[#6E6560] dark:text-[#C9C0B9] max-w-sm">
                Record, preview, and send voice notes.
            </p>
        </div>
    </div>

    <!-- Fixed Message Composer at the Bottom with Active Voice Recording Dock -->
    <div class="px-4 py-2.5 bg-[#FFFFFF] dark:bg-[#3A3835] border-t border-[#E3DCD7] dark:border-[#514D48] flex-shrink-0">
        <div class="max-w-4xl mx-auto flex flex-col gap-2">
            <!-- Workflow Interactive State Selector Tabs -->
            <div class="flex items-center justify-between border-b border-[#E3DCD7]/60 dark:border-[#514D48]/60 pb-1.5">
                <div class="flex items-center gap-1.5">
                    <span class="text-[10px] font-bold text-[#A07860] uppercase tracking-wider mr-1">Voice Workflow:</span>
                    <a asp-controller="Chat" asp-action="Conversation" class="px-2 py-0.5 rounded text-[11px] font-medium text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors">
                        1. Idle
                    </a>
                    <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-[#B3929D] text-white shadow-2xs flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#E5897A] animate-pulse"></span>
                        2. Active Recording
                    </span>
                    <button type="button" id="voicePreviewBtn" class="px-2 py-0.5 rounded text-[11px] font-medium text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">
                        3. Preview / Review
                    </button>
                    <button type="button" id="voiceUploadBtn" class="px-2 py-0.5 rounded text-[11px] font-medium text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">
                        4. Sending / Uploading
                    </button>
                </div>
                <div class="flex items-center gap-1 text-[10px] text-[#6E6560] dark:text-[#C9C0B9]">
                    <span class="w-2 h-2 rounded-full bg-[#6F9473]"></span>
                </div>
            </div>

            <!-- Active Recording Interface Dock -->
            <div class="flex items-center gap-2 bg-[#F8F6F3] dark:bg-[#302F2C] border border-[#B3929D] rounded-xl px-3.5 py-2 shadow-xs transition-all">
                <!-- Recording status indicator pill with live pulse & duration -->
                <div class="flex items-center gap-2 bg-[#FFFFFF] dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] rounded-full px-2.5 py-1 shadow-2xs">
                    <span class="w-2 h-2 rounded-full bg-[#C7624F] animate-pulse"></span>
                    <span class="text-[11px] font-bold text-[#C7624F] tracking-wide uppercase">REC</span>
                    <span class="h-3 w-px bg-[#E3DCD7] dark:bg-[#514D48]"></span>
                    <span id="recordingTimer" class="text-xs font-bold text-[#2B2725] dark:text-[#F0E9E2] font-mono">0:24</span>
                </div>

                <!-- Dynamic Live Audio Waveform Simulation -->
                <div class="flex-1 flex items-center justify-center gap-1 h-8 px-2 overflow-hidden" id="liveWaveform">
                    <span class="w-1 h-3 rounded-full bg-[#B3929D]/40 transition-all duration-300"></span>
                    <span class="w-1 h-5 rounded-full bg-[#B3929D]/60 transition-all duration-300"></span>
                    <span class="w-1 h-7 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-4 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-6 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-8 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-5 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-3 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-6 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-7 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-4 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-6 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-8 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-5 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-4 rounded-full bg-[#B3929D]/80 transition-all duration-300"></span>
                    <span class="w-1 h-6 rounded-full bg-[#B3929D] transition-all duration-300"></span>
                    <span class="w-1 h-3 rounded-full bg-[#B3929D]/60 transition-all duration-300"></span>
                    <span class="w-1 h-2 rounded-full bg-[#B3929D]/40 transition-all duration-300"></span>
                </div>

                <!-- Recording Control Actions -->
                <div class="flex items-center gap-1.5 flex-shrink-0">
                    <!-- Cancel / Discard Recording -->
                    <a asp-controller="Chat" asp-action="Conversation" class="px-2.5 py-1.5 rounded-lg flex items-center gap-1 text-xs font-semibold text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#C7624F] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors border border-transparent hover:border-[#E3DCD7] dark:hover:border-[#514D48]" title="Cancel recording">
                        <svg class="w-3.5 h-3.5 text-[#C7624F]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                        <span>Cancel</span>
                    </a>

                    <!-- Pause / Stop button -->
                    <button id="pauseRecordBtn" type="button" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] bg-[#FFFFFF] dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors shadow-2xs cursor-pointer" title="Pause Recording">
                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"></path></svg>
                    </button>

                    <!-- Send Voice Note Button -->
                    <a asp-controller="Chat" asp-action="Conversation" class="w-9 h-9 rounded-lg bg-[#B3929D] text-white flex items-center justify-center hover:opacity-95 active:scale-95 transition-all shadow-xs flex-shrink-0 cursor-pointer" title="Send Voice Note">
                        <svg class="w-4 h-4 translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
                    </a>
                </div>
            </div>

            <!-- Keyboard Shortcuts & Helper Hint -->
            <div class="flex items-center justify-between text-[10px] text-[#6E6560] dark:text-[#C9C0B9] px-1 font-medium">
                <div>
                    <span>Hold <kbd class="px-1.5 py-0.5 bg-[#F0E9DF] dark:bg-[#3A3835] rounded border border-[#E3DCD7] dark:border-[#514D48]">Space</kbd> or click to record</span>
                    <span class="mx-1.5">•</span>
                    <span><kbd class="px-1.5 py-0.5 bg-[#F0E9DF] dark:bg-[#3A3835] rounded border border-[#E3DCD7] dark:border-[#514D48]">Esc</kbd> to discard</span>
                </div>
                <div class="flex items-center gap-1.5 text-[#A07860] dark:text-[#D8C080]">
                    <span>Microphone ready</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/voice-recording-page.js" asp-append-version="true"></script>
}