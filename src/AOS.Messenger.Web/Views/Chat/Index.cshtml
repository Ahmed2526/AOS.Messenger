@model AOS.Messenger.Web.Models.ChatIndexViewModel
@{
    ViewData["Title"] = "A♡S Messenger - Desktop App";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    var bootstrapData = new
    {
        initialConversationId = (string?)null,
        currentUserId = currentUserId,
        loginUrl = "/Account/Login",
        meta = (object?)null,
        nextCursor = (string?)null,
        hasMore = false
    };
}

<div id="chat-shell-root"
     data-current-user-id="@currentUserId"
     class="flex-1 h-full min-h-0 w-full flex flex-col bg-[#F8F6F3] dark:bg-[#302F2C] min-w-0 overflow-hidden relative">
    <div id="chat-live-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

    @await Html.PartialAsync("_ChatEmptyState", false)

    <!-- Hidden Active Conversation Shell Pane (populated on zero-refresh conversation switches) -->
    <div id="chat-active-pane" class="hidden flex-1 h-full min-h-0 w-full flex flex-col min-w-0 overflow-hidden relative">
        @await Html.PartialAsync("_ChatActivePaneEmpty")
    </div>

    <!-- Hidden Anti-Forgery Token Form for Fetch Requests -->
    <form id="antiForgeryForm" class="hidden">
        @Html.AntiForgeryToken()
    </form>

    <script id="chat-bootstrap" type="application/json">@Json.Serialize(bootstrapData)</script>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script type="module" src="~/js/chat-actions.js" asp-append-version="true"></script>
    <script type="module" src="~/js/chat-shell.js" asp-append-version="true"></script>
}
