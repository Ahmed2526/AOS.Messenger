@{
    ViewData["Title"] = "A♡S Messenger - Attachment Workflow & Previews";
}

<!-- Active Conversation Area & Attachment Trays -->
<div class="flex-1 h-full min-h-full w-full flex flex-col bg-[#F8F6F3] dark:bg-[#302F2C] min-w-0 overflow-hidden relative">
    <!-- Top Chat Header -->
    <div class="h-14 px-5 bg-[#FFFFFF] dark:bg-[#3A3835] border-b border-[#E3DCD7] dark:border-[#514D48] flex items-center justify-between flex-shrink-0 z-10 shadow-2xs">
        <div class="flex items-center gap-3">
            <div class="relative">
                <div class="w-9 h-9 rounded-full bg-[#B3929D]/20 dark:bg-[#B3929D]/25 text-[#B3929D] border border-[#B3929D]/40 dark:border-[#B3929D]/50 font-bold text-xs flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">person</span>
                </div>
                <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-[#6F9473] border-2 border-[#FFFFFF] dark:border-[#3A3835]"></span>
            </div>
            <div>
                <div class="flex items-center gap-1.5">
                    <h2 class="text-sm font-bold text-[#2B2725] dark:text-[#F0E9E2] leading-tight">Conversation</h2>
                </div>
                <div class="flex items-center gap-1.5 text-[11px] text-[#6F9473] font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#6F9473]"></span>
                    <span>Direct conversation • Attachments</span>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-1">
            <button type="button" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors" title="Search in conversation">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </button>
            <a asp-controller="Chat" asp-action="VoiceRecording" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors" title="Audio Call">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </a>
            <a asp-controller="Profile" asp-action="Index" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors" title="Conversation Details">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </a>
            <div class="h-4 w-px bg-[#E3DCD7] dark:bg-[#514D48] mx-1"></div>
            <a asp-controller="Chat" asp-action="ContextMenu" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors" title="More Actions">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </a>
        </div>
    </div>

    <!-- Clean Empty State Area for Attachment Showcase -->
    <div class="flex-1 overflow-y-auto custom-scroll p-8 flex flex-col justify-center items-center text-center select-none">
        <div class="max-w-md flex flex-col items-center">
            <div class="w-16 h-16 rounded-2xl bg-[#FFFFFF] dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] flex items-center justify-center mb-4 shadow-sm text-[#B3929D]">
                <span class="material-symbols-outlined text-[32px]">attach_file</span>
            </div>
            <h3 class="text-base font-bold text-[#2B2725] dark:text-[#F0E9E2] mb-1">
                Attachment Previews
            </h3>
            <p class="text-xs text-[#6E6560] dark:text-[#C9C0B9] max-w-sm">
                Attach media, documents, or images to preview them before sending.
            </p>
        </div>
    </div>

    <!-- Fixed Message Composer at the Bottom with Active Attachment Previews & Menu -->
    <div class="px-4 py-2.5 bg-[#FFFFFF] dark:bg-[#3A3835] border-t border-[#E3DCD7] dark:border-[#514D48] flex-shrink-0 relative">
        <div class="max-w-4xl mx-auto relative">
            <!-- Attach Media Popup Menu -->
            <div class="absolute -top-36 left-0 z-30 w-52 bg-[#FFFFFF] dark:bg-[#45423E] border border-[#E3DCD7] dark:border-[#514D48] rounded-xl shadow-md p-1.5 flex flex-col gap-0.5">
                <div class="px-2 py-1 text-[10px] font-bold uppercase text-[#6E6560] dark:text-[#C9C0B9] tracking-wider">
                    Attach Media
                </div>
                <button type="button" class="w-full flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-[#2B2725] dark:text-[#F0E9E2] bg-[#F0E9DF]/80 dark:bg-[#514D49] hover:bg-[#F0E9DF] dark:hover:bg-[#5B5752] transition-colors text-left">
                    <div class="w-6 h-6 rounded-md bg-[#B3929D]/20 text-[#B3929D] flex items-center justify-center">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                    </div>
                    <span>Photos &amp; Videos</span>
                    <span class="ml-auto w-1.5 h-1.5 rounded-full bg-[#B3929D]"></span>
                </button>
                <button type="button" class="w-full flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-[#2B2725] dark:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#514D49] transition-colors text-left">
                    <div class="w-6 h-6 rounded-md bg-[#A07860]/20 text-[#A07860] dark:text-[#D8C080] flex items-center justify-center">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                    </div>
                    <span>Document</span>
                </button>
                <button type="button" class="w-full flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-[#2B2725] dark:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#514D49] transition-colors text-left">
                    <div class="w-6 h-6 rounded-md bg-[#D8C080]/30 text-[#8C7338] dark:text-[#D8C080] flex items-center justify-center">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path><circle cx="12" cy="13" r="3"></circle></svg>
                    </div>
                    <span>Camera</span>
                </button>
            </div>

            <!-- Pending Attachments Tray -->
            <div class="mb-2.5 p-2 bg-[#F8F6F3] dark:bg-[#302F2C] border border-[#E3DCD7] dark:border-[#514D48] rounded-xl flex flex-col gap-2 shadow-2xs">
                <div class="flex items-center justify-between px-1">
                    <div class="flex items-center gap-2">
                        <span class="text-[11px] font-bold text-[#2B2725] dark:text-[#F0E9E2]">Pending Attachments (2)</span>
                        <span class="text-[10px] px-1.5 py-0.2 bg-[#B3929D]/20 text-[#735761] dark:text-[#E1BDC9] rounded font-semibold">Ready to send</span>
                    </div>
                    <button type="button" class="text-[10px] text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#C7624F] font-semibold transition-colors">Clear all</button>
                </div>

                <!-- Ready Attachments Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    <!-- Pending Attachment 1: Video -->
                    <div class="relative rounded-lg overflow-hidden border border-[#E3DCD7] dark:border-[#514D48] bg-[#FFFFFF] dark:bg-[#3A3835] p-1.5 flex gap-2.5">
                        <div class="relative w-20 h-16 rounded-md overflow-hidden flex-shrink-0 group bg-stone-200 dark:bg-stone-700 flex items-center justify-center">
                            <span class="material-symbols-outlined text-stone-400">videocam</span>
                            <span class="absolute bottom-1 left-1 px-1 rounded bg-[#2B2725]/70 text-[9px] text-white font-medium">0:42</span>
                        </div>
                        <div class="flex-1 min-w-0 flex flex-col justify-between py-0.5">
                            <div class="flex items-start justify-between gap-1">
                                <span class="text-[11px] font-bold text-[#2B2725] dark:text-[#F0E9E2] truncate">Sample_Recording.mp4</span>
                                <button type="button" class="w-4 h-4 rounded-full bg-[#E3DCD7] dark:bg-[#514D48] hover:bg-[#C7624F] hover:text-white text-[#6E6560] dark:text-[#C9C0B9] flex items-center justify-center transition-colors flex-shrink-0" title="Remove video">
                                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
                                </button>
                            </div>
                            <p class="text-[10px] text-[#6E6560] dark:text-[#C9C0B9]">Video • 8.4 MB</p>
                            <div class="flex items-center gap-1 text-[10px] text-[#6F9473] font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#6F9473]"></span>
                                <span>Ready to send</span>
                            </div>
                        </div>
                    </div>

                    <!-- Pending Attachment 2: Document -->
                    <div class="relative rounded-lg overflow-hidden border border-[#E3DCD7] dark:border-[#514D48] bg-[#FFFFFF] dark:bg-[#3A3835] p-1.5 flex gap-2.5">
                        <div class="w-14 h-16 rounded-md bg-[#A07860]/15 dark:bg-[#A07860]/25 border border-[#A07860]/30 text-[#A07860] dark:text-[#D8C080] flex flex-col items-center justify-center flex-shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                            <span class="text-[9px] font-bold uppercase mt-0.5">PDF</span>
                        </div>
                        <div class="flex-1 min-w-0 flex flex-col justify-between py-0.5">
                            <div class="flex items-start justify-between gap-1">
                                <span class="text-[11px] font-bold text-[#2B2725] dark:text-[#F0E9E2] truncate">Document_Sample.pdf</span>
                                <button type="button" class="w-4 h-4 rounded-full bg-[#E3DCD7] dark:bg-[#514D48] hover:bg-[#C7624F] hover:text-white text-[#6E6560] dark:text-[#C9C0B9] flex items-center justify-center transition-colors flex-shrink-0" title="Remove document">
                                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
                                </button>
                            </div>
                            <p class="text-[10px] text-[#6E6560] dark:text-[#C9C0B9]">Document • 2.4 MB</p>
                            <div class="flex items-center gap-1 text-[10px] text-[#6F9473] font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#6F9473]"></span>
                                <span>Ready to send</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Input Controls Row -->
            <div class="flex items-end gap-2">
                <button type="button" class="w-9 h-9 rounded-lg flex items-center justify-center bg-[#F0E9DF] dark:bg-[#45423E] text-[#2B2725] dark:text-[#F0E9E2] border border-[#B3929D] transition-colors flex-shrink-0 shadow-2xs" title="Attach File or Media">
                    <svg class="w-4 h-4 text-[#735761] dark:text-[#E1BDC9]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                </button>
                <div class="flex-1 bg-[#F8F6F3] dark:bg-[#302F2C] border border-[#E3DCD7] dark:border-[#514D48] rounded-lg flex items-center px-3 py-1 focus-within:border-[#B3929D] focus-within:ring-1 focus-within:ring-[#B3929D] transition-all">
                    <textarea class="w-full bg-transparent text-xs font-medium text-[#2B2725] dark:text-[#F0E9E2] placeholder-[#6E6560] dark:placeholder-[#C9C0B9] focus:outline-none resize-none py-1 max-h-32" placeholder="Write a message..." rows="1"></textarea>
                    <button type="button" class="p-1 text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] transition-colors rounded-lg flex-shrink-0" title="Add Emoji">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                    </button>
                </div>
                <a asp-controller="Chat" asp-action="VoiceRecording" class="w-9 h-9 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors flex-shrink-0 border border-transparent hover:border-[#E3DCD7] dark:hover:border-[#514D48]" title="Record Voice Message">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                </a>
                <button type="button" class="w-9 h-9 rounded-lg bg-[#B3929D] text-white flex items-center justify-center hover:opacity-95 active:scale-95 transition-all shadow-2xs flex-shrink-0" title="Send Message">
                    <svg class="w-4 h-4 translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
                </button>
            </div>

            <!-- Footer Keyboard Hint -->
            <div class="text-center mt-1.5">
                <span class="text-[10px] text-[#6E6560] dark:text-[#C9C0B9] font-medium">Press <kbd class="px-1.5 py-0.5 text-[10px] bg-[#F0E9DF] dark:bg-[#45423E] rounded border border-[#E3DCD7] dark:border-[#514D48]">Return</kbd> to send, <kbd class="px-1.5 py-0.5 text-[10px] bg-[#F0E9DF] dark:bg-[#45423E] rounded border border-[#E3DCD7] dark:border-[#514D48]">Shift + Return</kbd> for new line</span>
            </div>
        </div>
    </div>
</div>
