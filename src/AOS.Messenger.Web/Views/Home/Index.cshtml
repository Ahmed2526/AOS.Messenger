@{
    ViewData["Title"] = "Welcome - A♡S Messenger";
}

<div class="flex-1 h-full min-h-full w-full flex flex-col items-center justify-center p-8 text-center bg-[#F8F6F3] dark:bg-[#302F2C] select-none">
    <div class="max-w-md flex flex-col items-center">
        <div class="w-20 h-20 rounded-3xl bg-[#FFFFFF] dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] flex items-center justify-center mb-6 shadow-sm">
            <svg width="48" height="36" viewBox="0 0 70 50" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 40L22 10L32 40M15 31H29" stroke="#A07860" class="dark:stroke-[#F0E9E2]" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M35 24C35 22 36.5 19 39 19C41.5 19 43 21 43 23C43 27 35 32 35 32C35 32 27 27 27 23C27 21 28.5 19 31 19C33.5 19 35 22 35 24Z" fill="#B3929D" stroke="#B3929D" stroke-width="1.5"></path>
                <path d="M42 38C46 41 54 41 56 36C58 31 46 29 48 20C50 13 58 13 62 17" stroke="#A07860" class="dark:stroke-[#F0E9E2]" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
        </div>
        <h1 class="text-2xl font-bold text-[#2B2725] dark:text-[#F0E9E2] tracking-tight mb-2">Welcome to A♡S Messenger</h1>
        <p class="text-sm text-[#6E6560] dark:text-[#C9C0B9] leading-relaxed mb-6">
            A warm, secure, modern desktop-class messaging application.
        </p>
        <div class="flex items-center gap-3">
            <a asp-controller="Chat" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#B3929D] hover:bg-[#A07860] text-white text-xs font-semibold shadow-xs transition-colors">
                <span>Open Messenger</span>
            </a>
        </div>
    </div>
</div>
