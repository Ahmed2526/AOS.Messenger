@model AOS.Messenger.Web.Controllers.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password";
}

<div class="w-full flex-1 min-h-[calc(100vh-140px)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-6 bg-surface-lowest dark:bg-[#1E1F23] p-8 rounded-2xl border border-outline-variant/30 shadow-xl">
        <div class="text-center">
            <h2 class="text-2xl font-bold font-headline text-on-surface dark:text-white">Choose a new password</h2>
            <p class="text-sm text-secondary dark:text-gray-400 mt-1">Please enter your new password below</p>
        </div>

        <form asp-action="ResetPassword" method="post" class="space-y-4">
            <input type="hidden" asp-for="Token" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="text-xs text-error dark:text-red-400"></div>
            }

            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-on-surface dark:text-gray-300 uppercase tracking-wider mb-1.5"></label>
                <input asp-for="Email" class="w-full px-4 py-2.5 bg-surface-low dark:bg-[#2A2B30] border border-outline-variant/40 rounded-xl text-sm text-on-surface dark:text-white" readonly />
            </div>

            <div>
                <label asp-for="NewPassword" class="block text-xs font-semibold text-on-surface dark:text-gray-300 uppercase tracking-wider mb-1.5"></label>
                <input asp-for="NewPassword" class="w-full px-4 py-2.5 bg-surface-low dark:bg-[#2A2B30] border border-outline-variant/40 rounded-xl text-sm text-on-surface dark:text-white" placeholder="Min. 8 characters" autofocus />
                <span asp-validation-for="NewPassword" class="text-xs text-error dark:text-red-400 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-semibold text-on-surface dark:text-gray-300 uppercase tracking-wider mb-1.5"></label>
                <input asp-for="ConfirmPassword" class="w-full px-4 py-2.5 bg-surface-low dark:bg-[#2A2B30] border border-outline-variant/40 rounded-xl text-sm text-on-surface dark:text-white" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-error dark:text-red-400 mt-1 block"></span>
            </div>

            <button type="submit" class="w-full py-2.5 px-4 bg-primary text-white rounded-xl text-sm font-semibold hover:bg-primary/90 transition-all shadow-md">
                Reset Password
            </button>
        </form>
    </div>
</div>
