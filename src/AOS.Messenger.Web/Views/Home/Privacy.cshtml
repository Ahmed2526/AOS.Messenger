@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="flex-1 h-full min-h-full w-full flex flex-col p-8 bg-[#F8F6F3] dark:bg-[#302F2C]">
    <div class="max-w-3xl mx-auto w-full bg-white dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] rounded-2xl p-6 md:p-8 shadow-xs">
        <h1 class="text-xl font-bold text-[#2B2725] dark:text-[#F0E9E2] tracking-tight mb-4">@ViewData["Title"]</h1>
        <p class="text-xs text-[#6E6560] dark:text-[#C9C0B9] leading-relaxed">
            Your privacy and security are fundamental to A♡S Messenger. All conversations, metadata, and media are handled in strict compliance with application security invariants.
        </p>
    </div>
</div>
