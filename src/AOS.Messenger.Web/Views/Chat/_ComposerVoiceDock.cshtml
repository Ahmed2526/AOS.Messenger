<!-- Inline Voice Recording & Preview Dock -->
<div id="composer-voice-dock" class="hidden px-3 sm:px-4 py-2.5">
    <div class="max-w-4xl mx-auto flex flex-col gap-1.5">
        <div id="voice-dock-recording" class="hidden flex items-center gap-2 min-w-0 bg-[#F8F6F3] dark:bg-[#302F2C] border border-[#B3929D] rounded-xl px-2.5 sm:px-3.5 py-2 shadow-2xs">
            <div class="flex items-center gap-1.5 bg-[#FFFFFF] dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] rounded-full px-2 py-1 shrink-0 shadow-2xs">
                <span id="voice-rec-dot" class="w-2 h-2 rounded-full bg-[#C7624F] animate-pulse"></span>
                <span id="voice-rec-status" class="text-[10px] font-bold text-[#C7624F] tracking-wide uppercase">REC</span>
                <span class="h-3 w-px bg-[#E3DCD7] dark:bg-[#514D48]"></span>
                <span id="voice-rec-timer" class="text-xs font-bold text-[#2B2725] dark:text-[#F0E9E2] font-mono tabular-nums">0:00</span>
            </div>
            <span id="voice-rec-limit-hint" class="hidden text-[10px] font-semibold text-amber-700 dark:text-amber-300 shrink-0"></span>
            <div id="voice-live-waveform" class="flex-1 min-w-0 flex items-center justify-center gap-[2px] h-7 px-1 overflow-hidden" aria-hidden="true"></div>
            <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
                <button id="voice-discard-btn" type="button" aria-label="Discard recording" title="Discard recording (Esc)" class="w-8 h-8 sm:w-auto sm:px-2.5 rounded-lg flex items-center justify-center gap-1 text-xs font-semibold text-[#C7624F] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                    <span class="hidden sm:inline">Discard</span>
                </button>
                <button id="voice-pause-btn" type="button" aria-label="Pause recording" title="Pause recording" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] bg-[#FFFFFF] dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">
                    <span id="voice-pause-icon" class="material-symbols-outlined text-[18px]">pause</span>
                </button>
                <button id="voice-stop-preview-btn" type="button" aria-label="Stop and preview recording" title="Stop &amp; Preview" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#735761] dark:text-[#E1BDC9] bg-[#FFFFFF] dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-[18px] icon-filled">stop</span>
                </button>
                <button id="voice-send-now-btn" type="button" aria-label="Send voice message" title="Send Voice Message" class="w-9 h-9 rounded-lg bg-[#B3929D] text-white flex items-center justify-center hover:opacity-95 active:scale-95 transition-all shadow-2xs shrink-0 cursor-pointer">
                    <svg class="w-4 h-4 translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
                </button>
            </div>
        </div>

        <div id="voice-dock-preview" class="hidden flex items-center gap-2 min-w-0 bg-[#F8F6F3] dark:bg-[#302F2C] border border-[#B3929D] rounded-xl px-2.5 sm:px-3.5 py-2 shadow-2xs">
            <button id="voice-preview-play-btn" type="button" aria-label="Play voice preview" title="Play preview" class="w-8 h-8 rounded-full bg-[#B3929D] text-white flex items-center justify-center shrink-0 hover:opacity-95 active:scale-95 transition-all cursor-pointer">
                <span id="voice-preview-play-icon" class="material-symbols-outlined text-[18px] icon-filled">play_arrow</span>
            </button>
            <div id="voice-preview-waveform" role="slider" tabindex="0" aria-label="Voice preview seek bar" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" class="flex-1 min-w-0 flex items-center gap-[1px] sm:gap-0.5 h-7 cursor-pointer touch-none"></div>
            <span id="voice-preview-timer" class="text-xs font-mono font-semibold text-[#2B2725] dark:text-[#F0E9E2] tabular-nums shrink-0">0:00</span>
            <audio id="voice-preview-audio" preload="metadata" class="hidden"></audio>
            <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
                <button id="voice-preview-discard-btn" type="button" aria-label="Discard preview" title="Discard (Esc)" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#C7624F] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                </button>
                <button id="voice-preview-rerecord-btn" type="button" aria-label="Re-record voice message" title="Re-record" class="w-8 h-8 sm:w-auto sm:px-2.5 rounded-lg flex items-center justify-center gap-1 text-xs font-semibold text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] bg-[#FFFFFF] dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-[17px]">mic</span>
                    <span class="hidden sm:inline">Re-record</span>
                </button>
                <button id="voice-preview-send-btn" type="button" aria-label="Send voice message" title="Send Voice Message" class="w-9 h-9 rounded-lg bg-[#B3929D] text-white flex items-center justify-center hover:opacity-95 active:scale-95 transition-all shadow-2xs shrink-0 cursor-pointer">
                    <svg class="w-4 h-4 translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
                </button>
            </div>
        </div>
        <div class="text-center text-[10px] text-[#6E6560] dark:text-[#C9C0B9] font-medium">
            <span>Max 20 min • Press <kbd class="px-1.5 py-0.5 bg-[#F0E9DF] dark:bg-[#45423E] rounded border border-[#E3DCD7] dark:border-[#514D48]">Esc</kbd> to discard</span>
        </div>
    </div>
</div>
