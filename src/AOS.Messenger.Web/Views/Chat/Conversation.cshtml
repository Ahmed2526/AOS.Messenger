@model AOS.Messenger.Web.Models.ChatConversationViewModel
@{
    ViewData["Title"] = $"{Model.Conversation.OtherParticipantName} - A♡S Messenger";
    var initials = GetInitials(Model.Conversation.OtherParticipantName, Model.Conversation.OtherParticipantHandle);
    var initData = new
    {
        conversationId = Model.Conversation.Id.Value.ToString(),
        currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "",
        peerUserId = Model.Conversation.OtherParticipantId.Value.ToString(),
        peerIsOnline = Model.Conversation.IsOnline,
        peerLastSeenAtUtc = Model.Conversation.LastSeenAtUtc?.ToString("o"),
        peerLastDeliveredMessageId = Model.Conversation.PeerLastDeliveredMessageId?.Value.ToString(),
        peerLastReadMessageId = Model.Conversation.PeerLastReadMessageId?.Value.ToString(),
        nextCursor = Model.NextCursor,
        hasMore = Model.NextCursor != null
    };
    var initJson = System.Text.Json.JsonSerializer.Serialize(initData);
}

@functions {
    public static string GetInitials(string? name, string? handle)
    {
        var raw = !string.IsNullOrWhiteSpace(name) ? name : (!string.IsNullOrWhiteSpace(handle) ? handle : "U");
        var parts = raw.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 1 && parts[0].Length > 0 && parts[1].Length > 0)
        {
            return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpperInvariant();
        }
        if (parts.Length == 1 && parts[0].Length > 0)
        {
            return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
        }
        return "U";
    }
}

<!-- Active Conversation Area -->
<div id="conversation-page-root"
     data-init="@initJson"
     class="flex-1 h-full min-h-0 w-full flex flex-col bg-[#F8F6F3] dark:bg-[#302F2C] min-w-0 overflow-hidden relative">
    <!-- Reconnecting / Offline Banner -->
    <div id="connection-banner" class="hidden absolute top-14 left-0 right-0 z-30 bg-[#A07860] text-white px-4 py-2 flex items-center justify-between text-xs shadow-md transition-all">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px] animate-spin">sync</span>
            <span id="connection-banner-text">Reconnecting to chat...</span>
        </div>
        <span class="text-[11px] opacity-80">Syncing live messages</span>
    </div>

    <!-- Transient Action Error Banner -->
    <div id="chat-action-error" role="alert" class="hidden absolute top-16 left-1/2 -translate-x-1/2 z-40 max-w-[calc(100vw-2rem)] rounded-xl bg-red-600 text-white px-3.5 py-2 text-xs font-medium shadow-lg"></div>

    <!-- Top Chat Header -->
    <div id="active-conversation-header"
         data-peer-user-id="@Model.Conversation.OtherParticipantId.Value"
         class="h-14 px-3 sm:px-5 bg-[#FFFFFF] dark:bg-[#3A3835] border-b border-[#E3DCD7] dark:border-[#514D48] flex items-center justify-between shrink-0 z-10 shadow-2xs">
        <div class="flex items-center gap-2.5 sm:gap-3 min-w-0 flex-1 mr-2">
            <!-- Mobile Back to Chats Button -->
            <a asp-controller="Chat" asp-action="Index" class="md:hidden shrink-0 p-1.5 rounded-lg text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors flex items-center justify-center" title="Back to Chats" aria-label="Back to Chats">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </a>
            <div class="relative shrink-0">
                <div class="w-9 h-9 rounded-full bg-[#B3929D]/20 dark:bg-[#B3929D]/25 text-[#735761] dark:text-[#E1BDC9] border border-[#B3929D]/40 dark:border-[#B3929D]/50 font-bold text-xs flex items-center justify-center">
                    @initials
                </div>
                <span id="header-presence-dot"
                      data-presence-dot="true"
                      class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full @(Model.Conversation.IsOnline ? "bg-[#6F9473]" : "bg-stone-400 dark:bg-stone-500") border-2 border-[#FFFFFF] dark:border-[#3A3835]"></span>
            </div>
            <!-- Peer Identity Block -->
            <div id="peer-identity-block" class="flex-1 min-w-0 overflow-hidden">
                <div class="flex items-center gap-1.5 min-w-0 truncate">
                    <h2 class="text-sm font-bold text-[#2B2725] dark:text-[#F0E9E2] leading-tight truncate">@Model.Conversation.OtherParticipantName</h2>
                    <span class="text-xs text-[#6E6560] dark:text-[#C9C0B9] font-medium truncate">@@@Model.Conversation.OtherParticipantHandle</span>
                    @if (Model.Conversation.IsPinned)
                    {
                        <span class="material-symbols-outlined text-[15px] text-[#A07860] dark:text-[#D8C080] shrink-0" title="Pinned conversation">push_pin</span>
                    }
                    @if (Model.Conversation.IsMuted)
                    {
                        <span class="material-symbols-outlined text-[15px] text-[#6E6560] dark:text-[#C9C0B9] shrink-0" title="Muted conversation">volume_off</span>
                    }
                    @if (Model.Conversation.IsBlocked)
                    {
                        <span class="px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-red-100 text-red-700 dark:bg-red-950/40 dark:text-red-400 shrink-0">Blocked</span>
                    }
                </div>
                <div id="header-presence-container" class="flex items-center gap-1.5 text-[11px] text-[#6E6560] dark:text-[#C9C0B9] truncate">
                    <span id="typing-indicator" class="hidden text-[#B3929D] font-semibold animate-pulse shrink-0">typing...</span>
                    <span id="header-presence-text" data-presence-text="true" class="truncate">
                        @(Model.Conversation.IsOnline
                            ? "Online"
                            : (Model.Conversation.LastSeenAtUtc.HasValue
                                ? "Last seen " + Model.Conversation.LastSeenAtUtc.Value.ToString("g")
                                : "Offline"))
                    </span>
                    @if (!string.IsNullOrWhiteSpace(Model.Conversation.OtherParticipantBio))
                    {
                        <span class="text-stone-300 dark:text-stone-600 shrink-0">•</span>
                        <span class="truncate">@Model.Conversation.OtherParticipantBio</span>
                    }
                </div>
            </div>
        </div>

        <!-- Desktop Action Buttons (md: and up) -->
        <div id="desktop-chat-actions" class="hidden md:flex items-center gap-1 shrink-0">
            <!-- Pin / Unpin Action -->
            <form method="post" asp-controller="Chat" asp-action="Pin" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="conversationId" value="@Model.Conversation.Id.Value" />
                <input type="hidden" name="isPinned" value="@((!Model.Conversation.IsPinned).ToString().ToLowerInvariant())" />
                <button type="submit" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer" title="@(Model.Conversation.IsPinned ? "Unpin conversation" : "Pin conversation")">
                    <span class="material-symbols-outlined text-[18px]">@(Model.Conversation.IsPinned ? "keep_off" : "push_pin")</span>
                </button>
            </form>

            <!-- Mute / Unmute Action -->
            <form method="post" asp-controller="Chat" asp-action="Mute" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="conversationId" value="@Model.Conversation.Id.Value" />
                <input type="hidden" name="isMuted" value="@((!Model.Conversation.IsMuted).ToString().ToLowerInvariant())" />
                <button type="submit" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer" title="@(Model.Conversation.IsMuted ? "Unmute conversation" : "Mute conversation")">
                    <span class="material-symbols-outlined text-[18px]">@(Model.Conversation.IsMuted ? "volume_up" : "volume_off")</span>
                </button>
            </form>

            <!-- Archive Action -->
            <form method="post" asp-controller="Chat" asp-action="Archive" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="conversationId" value="@Model.Conversation.Id.Value" />
                <input type="hidden" name="isArchived" value="true" />
                <button type="submit" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer" title="Archive conversation">
                    <span class="material-symbols-outlined text-[18px]">archive</span>
                </button>
            </form>

            <div class="h-4 w-px bg-[#E3DCD7] dark:bg-[#514D48] mx-1"></div>

            <!-- Clear Chat Action -->
            <form method="post" asp-controller="Chat" asp-action="Clear" class="inline" data-confirm="Clear chat history for yourself? Other participants will not be affected.">
                @Html.AntiForgeryToken()
                <input type="hidden" name="conversationId" value="@Model.Conversation.Id.Value" />
                <button type="submit" class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#A07860] dark:hover:text-[#D8C080] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer" title="Clear chat history">
                    <span class="material-symbols-outlined text-[18px]">cleaning_services</span>
                </button>
            </form>

            <!-- Delete Conversation Action -->
            <form method="post" asp-controller="Chat" asp-action="Delete" class="inline" data-confirm="Delete this conversation? It will remain hidden until a new message arrives.">
                @Html.AntiForgeryToken()
                <input type="hidden" name="conversationId" value="@Model.Conversation.Id.Value" />
                <button type="submit" class="w-8 h-8 rounded-lg flex items-center justify-center text-red-500 hover:text-red-700 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors cursor-pointer" title="Delete conversation">
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                </button>
            </form>
        </div>

        <!-- Mobile Overflow Action Menu (< md) -->
        <div id="mobile-chat-actions" class="relative md:hidden shrink-0">
            <button type="button"
                    data-chat-actions-toggle
                    aria-expanded="false"
                    aria-label="Conversation actions"
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-[20px]">more_vert</span>
            </button>
            <div data-chat-actions-menu
                 class="hidden absolute right-0 top-full mt-1.5 w-48 rounded-xl bg-white dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] shadow-lg py-1.5 z-50 text-xs flex flex-col">
                <!-- Pin / Unpin Action -->
                <form method="post" asp-controller="Chat" asp-action="Pin" class="w-full">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="conversationId" value="@Model.Conversation.Id.Value" />
                    <input type="hidden" name="isPinned" value="@((!Model.Conversation.IsPinned).ToString().ToLowerInvariant())" />
                    <button type="submit" class="w-full px-3 py-2 text-left flex items-center gap-2.5 text-[#2B2725] dark:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">
                        <span class="material-symbols-outlined text-[18px] text-[#6E6560] dark:text-[#C9C0B9]">@(Model.Conversation.IsPinned ? "keep_off" : "push_pin")</span>
                        <span>@(Model.Conversation.IsPinned ? "Unpin conversation" : "Pin conversation")</span>
                    </button>
                </form>

                <!-- Mute / Unmute Action -->
                <form method="post" asp-controller="Chat" asp-action="Mute" class="w-full">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="conversationId" value="@Model.Conversation.Id.Value" />
                    <input type="hidden" name="isMuted" value="@((!Model.Conversation.IsMuted).ToString().ToLowerInvariant())" />
                    <button type="submit" class="w-full px-3 py-2 text-left flex items-center gap-2.5 text-[#2B2725] dark:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">
                        <span class="material-symbols-outlined text-[18px] text-[#6E6560] dark:text-[#C9C0B9]">@(Model.Conversation.IsMuted ? "volume_up" : "volume_off")</span>
                        <span>@(Model.Conversation.IsMuted ? "Unmute conversation" : "Mute conversation")</span>
                    </button>
                </form>

                <!-- Archive Action -->
                <form method="post" asp-controller="Chat" asp-action="Archive" class="w-full">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="conversationId" value="@Model.Conversation.Id.Value" />
                    <input type="hidden" name="isArchived" value="true" />
                    <button type="submit" class="w-full px-3 py-2 text-left flex items-center gap-2.5 text-[#2B2725] dark:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">
                        <span class="material-symbols-outlined text-[18px] text-[#6E6560] dark:text-[#C9C0B9]">archive</span>
                        <span>Archive conversation</span>
                    </button>
                </form>

                <div class="h-px bg-[#E3DCD7] dark:bg-[#514D48] my-1"></div>

                <!-- Clear Chat Action -->
                <form method="post" asp-controller="Chat" asp-action="Clear" class="w-full" data-confirm="Clear chat history for yourself? Other participants will not be affected.">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="conversationId" value="@Model.Conversation.Id.Value" />
                    <button type="submit" class="w-full px-3 py-2 text-left flex items-center gap-2.5 text-[#A07860] dark:text-[#D8C080] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">cleaning_services</span>
                        <span>Clear chat history</span>
                    </button>
                </form>

                <!-- Delete Conversation Action -->
                <form method="post" asp-controller="Chat" asp-action="Delete" class="w-full" data-confirm="Delete this conversation? It will remain hidden until a new message arrives.">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="conversationId" value="@Model.Conversation.Id.Value" />
                    <button type="submit" class="w-full px-3 py-2 text-left flex items-center gap-2.5 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">delete</span>
                        <span>Delete conversation</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Scrollable Message Stream -->
    <div id="message-stream" class="flex-1 min-h-0 overflow-y-auto custom-scroll p-4 md:p-6 space-y-3 flex flex-col">
        <!-- Loading indicator for keyset pagination -->
        <div id="messages-loading-top" class="hidden flex items-center justify-center py-2 text-xs text-[#6E6560] dark:text-[#C9C0B9] gap-2">
            <span class="material-symbols-outlined animate-spin text-[16px]">progress_activity</span>
            <span>Loading older messages...</span>
        </div>

        <!-- Empty state when no messages exist -->
        <div id="no-messages-placeholder" class="@(Model.InitialMessages.Count == 0 ? "flex" : "hidden") flex-1 flex-col justify-center items-center text-center select-none py-12">
            <div class="w-16 h-16 rounded-2xl bg-[#FFFFFF] dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] flex items-center justify-center mb-4 shadow-sm text-[#B3929D]">
                <span class="material-symbols-outlined text-[32px]">chat_bubble_outline</span>
            </div>
            <h3 class="text-base font-bold text-[#2B2725] dark:text-[#F0E9E2] mb-1">
                No messages yet in this conversation
            </h3>
            <p class="text-xs text-[#6E6560] dark:text-[#C9C0B9] max-w-sm">
                Send a message below to start the conversation with @Model.Conversation.OtherParticipantName.
            </p>
        </div>

        <!-- Initial SSR Messages Container -->
        <div id="messages-container"
             class="space-y-3 flex flex-col"
             data-conversation-id="@Model.Conversation.Id.Value"
             data-current-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")"
             data-peer-user-id="@Model.Conversation.OtherParticipantId.Value"
             data-peer-is-online="@(Model.Conversation.IsOnline ? "true" : "false")"
             data-peer-last-seen="@(Model.Conversation.LastSeenAtUtc?.ToString("o") ?? "")"
             data-peer-last-delivered-id="@(Model.Conversation.PeerLastDeliveredMessageId?.Value.ToString() ?? "")"
             data-peer-last-read-id="@(Model.Conversation.PeerLastReadMessageId?.Value.ToString() ?? "")"
             data-next-cursor="@(Model.NextCursor ?? "")"
             data-has-more="@(Model.NextCursor != null ? "true" : "false")">
            @foreach (var message in Model.InitialMessages)
            {
                var msgInitials = GetInitials(message.SenderName, message.SenderHandle);
                if (message.IsOutgoing)
                {
                    var receiptStatus = "sent";
                    var receiptIcon = "done";
                    var receiptClass = "text-white/70";
                    if (Model.Conversation.PeerLastReadMessageId != null && message.Id.Value <= Model.Conversation.PeerLastReadMessageId.Value)
                    {
                        receiptStatus = "read";
                        receiptIcon = "done_all";
                        receiptClass = "text-sky-300";
                    }
                    else if (Model.Conversation.PeerLastDeliveredMessageId != null && message.Id.Value <= Model.Conversation.PeerLastDeliveredMessageId.Value)
                    {
                        receiptStatus = "delivered";
                        receiptIcon = "done_all";
                        receiptClass = "text-white/70";
                    }

                    <!-- Outgoing message (Right-aligned, warm rose) -->
                    <div id="msg-@message.Id.Value" class="flex flex-wrap justify-end items-center message-bubble-row group relative" data-message-id="@message.Id.Value" data-is-outgoing="true" data-deleted="@(message.IsDeletedForEveryone ? "true" : "false")" data-sender-id="@message.SenderId.Value" data-created-at="@message.CreatedAtUtc.ToString("o")">
                        <div class="message-bubble max-w-[75%] min-w-0 rounded-2xl rounded-tr-xs px-4 py-2 bg-[#B3929D] text-white shadow-2xs relative">
                            @if (message.ReplyTo != null)
                            {
                                <div class="mb-1.5 px-2.5 py-1 rounded bg-black/15 border-l-2 border-white/70 text-xs cursor-pointer hover:bg-black/25 transition-colors" data-reply-parent-id="@message.ReplyTo.Id.Value">
                                    <div class="font-bold text-[10px] text-white/95">@message.ReplyTo.SenderName</div>
                                    <div class="reply-preview-text truncate text-[10px] text-white/80">
                                        @if (message.ReplyTo.IsDeletedForEveryone)
                                        {
                                            <span class="italic">This message was deleted</span>
                                        }
                                        else
                                        {
                                            @message.ReplyTo.PreviewContent
                                        }
                                    </div>
                                </div>
                            }

                            @if (message.IsDeletedForEveryone)
                            {
                                <div class="message-text-content italic text-xs text-white/80 flex items-center gap-1.5 py-0.5">
                                    <span class="material-symbols-outlined text-[15px]">block</span>
                                    <span>This message was deleted</span>
                                </div>
                            }
                            else
                            {
                                <div class="message-text-content text-xs leading-relaxed whitespace-pre-wrap break-words">@message.Content</div>
                            }

                            <div class="flex items-center justify-end gap-1 mt-1 text-[10px] text-white/80">
                                <span class="text-[9px] italic edited-label @(message.EditedAtUtc.HasValue && !message.IsDeletedForEveryone ? "" : "hidden")">edited</span>
                                <span class="message-timestamp" data-created-at="@message.CreatedAtUtc.ToString("o")">@message.CreatedAtUtc.ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture)</span>
                                @if (!message.IsDeletedForEveryone)
                                {
                                    <span class="material-symbols-outlined text-[13px] select-none align-middle @receiptClass" data-message-id="@message.Id.Value" data-receipt-status="@receiptStatus">@receiptIcon</span>
                                }
                            </div>

                            <div class="reaction-pills-container flex flex-wrap gap-1 mt-1 @(message.Reactions != null && message.Reactions.Count > 0 ? "" : "hidden")">
                                @if (message.Reactions != null)
                                {
                                    foreach (var r in message.Reactions)
                                    {
                                        <button type="button" data-emoji="@r.Emoji" data-message-id="@message.Id.Value" class="reaction-pill inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs border transition-all cursor-pointer select-none @(r.ReactedByCurrentUser ? "border-white/80 bg-white/20 text-white font-bold" : "border-white/30 bg-black/10 text-white/90")" title="@(r.ReactedByCurrentUser ? $"Remove {r.Emoji} reaction" : $"React with {r.Emoji}")">
                                            <span class="text-xs select-none">@r.Emoji</span>
                                            <span class="text-[10px] font-semibold text-white/90">@r.Count</span>
                                        </button>
                                    }
                                }
                            </div>
                        </div>

                        @if (!message.IsDeletedForEveryone)
                        {
                            <div class="message-actions-bar opacity-100 sm:opacity-0 sm:group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity self-center shrink-0 mr-1 flex items-center gap-0.5">
                                <button type="button" data-action="react" class="w-6 h-6 sm:w-7 sm:h-7 rounded flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#B3929D] hover:bg-[#F0E9DF]/60 dark:hover:bg-[#45423E]/60 transition-colors cursor-pointer" title="Add reaction" aria-label="Add reaction">
                                    <span class="material-symbols-outlined text-[16px]">add_reaction</span>
                                </button>
                                <button type="button" class="reply-action-btn w-6 h-6 sm:w-7 sm:h-7 rounded flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#B3929D] hover:bg-[#F0E9DF]/60 dark:hover:bg-[#45423E]/60 transition-colors cursor-pointer" title="Reply to message" aria-label="Reply to message" data-id="@message.Id.Value" data-sender="@message.SenderName" data-preview="@message.Content">
                                    <span class="material-symbols-outlined text-[16px]">reply</span>
                                </button>
                                <button type="button" data-action="edit" class="w-6 h-6 sm:w-7 sm:h-7 rounded flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#B3929D] hover:bg-[#F0E9DF]/60 dark:hover:bg-[#45423E]/60 transition-colors cursor-pointer" title="Edit message" aria-label="Edit message">
                                    <span class="material-symbols-outlined text-[16px]">edit</span>
                                </button>
                                <button type="button" data-action="delete" class="w-6 h-6 sm:w-7 sm:h-7 rounded flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-red-500 hover:bg-[#F0E9DF]/60 dark:hover:bg-[#45423E]/60 transition-colors cursor-pointer" title="Delete message" aria-label="Delete message">
                                    <span class="material-symbols-outlined text-[16px]">delete</span>
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- Incoming message (Left-aligned, surface container) -->
                    <div id="msg-@message.Id.Value" class="flex flex-wrap justify-start items-center gap-2.5 message-bubble-row group relative" data-message-id="@message.Id.Value" data-is-outgoing="false" data-deleted="@(message.IsDeletedForEveryone ? "true" : "false")" data-sender-id="@message.SenderId.Value" data-created-at="@message.CreatedAtUtc.ToString("o")">
                        <div class="w-8 h-8 rounded-full bg-[#B3929D]/20 dark:bg-[#B3929D]/25 text-[#735761] dark:text-[#E1BDC9] border border-[#B3929D]/30 font-bold text-xs flex items-center justify-center flex-shrink-0 mt-1">
                            @msgInitials
                        </div>
                        <div class="message-bubble max-w-[75%] min-w-0 rounded-2xl rounded-tl-xs px-4 py-2 bg-[#FFFFFF] dark:bg-[#3A3835] text-[#2B2725] dark:text-[#F0E9E2] border border-[#E3DCD7] dark:border-[#514D48] shadow-2xs relative">
                            <div class="text-[11px] font-bold text-[#735761] dark:text-[#E1BDC9] mb-0.5">@message.SenderName</div>

                            @if (message.ReplyTo != null)
                            {
                                <div class="mb-1.5 px-2.5 py-1 rounded bg-[#F8F6F3] dark:bg-[#302F2C] border-l-2 border-[#B3929D] text-xs cursor-pointer hover:bg-[#F0E9DF] dark:hover:bg-[#3E3C38] transition-colors" data-reply-parent-id="@message.ReplyTo.Id.Value">
                                    <div class="font-bold text-[10px] text-[#2B2725] dark:text-[#F0E9E2]">@message.ReplyTo.SenderName</div>
                                    <div class="reply-preview-text truncate text-[10px] text-[#6E6560] dark:text-[#C9C0B9]">
                                        @if (message.ReplyTo.IsDeletedForEveryone)
                                        {
                                            <span class="italic">This message was deleted</span>
                                        }
                                        else
                                        {
                                            @message.ReplyTo.PreviewContent
                                        }
                                    </div>
                                </div>
                            }

                            @if (message.IsDeletedForEveryone)
                            {
                                <div class="message-text-content italic text-xs text-[#6E6560] dark:text-[#C9C0B9] flex items-center gap-1.5 py-0.5">
                                    <span class="material-symbols-outlined text-[15px]">block</span>
                                    <span>This message was deleted</span>
                                </div>
                            }
                            else
                            {
                                <div class="message-text-content text-xs leading-relaxed whitespace-pre-wrap break-words">@message.Content</div>
                            }

                            <div class="flex items-center justify-end gap-1 mt-1 text-[10px] text-[#6E6560] dark:text-[#C9C0B9]">
                                <span class="text-[9px] italic edited-label @(message.EditedAtUtc.HasValue && !message.IsDeletedForEveryone ? "" : "hidden")">edited</span>
                                <span class="message-timestamp" data-created-at="@message.CreatedAtUtc.ToString("o")">@message.CreatedAtUtc.ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture)</span>
                            </div>

                            <div class="reaction-pills-container flex flex-wrap gap-1 mt-1 @(message.Reactions != null && message.Reactions.Count > 0 ? "" : "hidden")">
                                @if (message.Reactions != null)
                                {
                                    foreach (var r in message.Reactions)
                                    {
                                        <button type="button" data-emoji="@r.Emoji" data-message-id="@message.Id.Value" class="reaction-pill inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs border transition-all cursor-pointer select-none @(r.ReactedByCurrentUser ? "border-[#B3929D] bg-[#B3929D]/20 text-[#735761] dark:text-[#E1BDC9] font-bold" : "border-[#E3DCD7] dark:border-[#514D48] bg-white dark:bg-[#3A3835] text-[#2B2725] dark:text-[#F0E9E2]")" title="@(r.ReactedByCurrentUser ? $"Remove {r.Emoji} reaction" : $"React with {r.Emoji}")">
                                            <span class="text-xs select-none">@r.Emoji</span>
                                            <span class="text-[10px] font-semibold text-[#6E6560] dark:text-[#C9C0B9]">@r.Count</span>
                                        </button>
                                    }
                                }
                            </div>
                        </div>

                        @if (!message.IsDeletedForEveryone)
                        {
                            <div class="message-actions-bar opacity-100 sm:opacity-0 sm:group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity self-center shrink-0 ml-1 flex items-center gap-0.5">
                                <button type="button" data-action="react" class="w-6 h-6 sm:w-7 sm:h-7 rounded flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#B3929D] hover:bg-[#F0E9DF]/60 dark:hover:bg-[#45423E]/60 transition-colors cursor-pointer" title="Add reaction" aria-label="Add reaction">
                                    <span class="material-symbols-outlined text-[16px]">add_reaction</span>
                                </button>
                                <button type="button" class="reply-action-btn w-6 h-6 sm:w-7 sm:h-7 rounded flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#B3929D] hover:bg-[#F0E9DF]/60 dark:hover:bg-[#45423E]/60 transition-colors cursor-pointer" title="Reply to message" aria-label="Reply to message" data-id="@message.Id.Value" data-sender="@message.SenderName" data-preview="@message.Content">
                                    <span class="material-symbols-outlined text-[16px]">reply</span>
                                </button>
                                <button type="button" data-action="delete" class="w-6 h-6 sm:w-7 sm:h-7 rounded flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-red-500 hover:bg-[#F0E9DF]/60 dark:hover:bg-[#45423E]/60 transition-colors cursor-pointer" title="Delete message" aria-label="Delete message">
                                    <span class="material-symbols-outlined text-[16px]">delete</span>
                                </button>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <!-- Fixed Message Composer Area -->
    <div id="active-conversation-composer" class="bg-[#FFFFFF] dark:bg-[#3A3835] border-t border-[#E3DCD7] dark:border-[#514D48] shrink-0">
        <!-- Active Reply Quote Banner -->
        <div id="composer-reply-banner" class="hidden px-5 py-2 bg-[#F0E9DF]/70 dark:bg-[#45423E]/70 border-b border-[#E3DCD7] dark:border-[#514D48] flex items-center justify-between text-xs">
            <div class="flex items-center gap-2.5 min-w-0">
                <span class="material-symbols-outlined text-[18px] text-[#B3929D]">reply</span>
                <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                        <span class="text-[10px] uppercase font-bold text-[#6E6560] dark:text-[#C9C0B9] tracking-wider">Replying to</span>
                        <span class="font-bold text-[11px] text-[#2B2725] dark:text-[#F0E9E2]" id="reply-banner-sender"></span>
                    </div>
                    <p class="truncate text-[11px] text-[#6E6560] dark:text-[#C9C0B9]" id="reply-banner-preview"></p>
                </div>
            </div>
            <button type="button" id="cancel-reply-btn" class="w-6 h-6 rounded flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] transition-colors" title="Cancel reply">
                <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
        </div>

        <!-- Composer Input Bar -->
        <div class="px-4 py-2.5 max-w-4xl mx-auto flex items-end gap-2">
            <a asp-controller="Chat" asp-action="Attachments" class="w-9 h-9 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors flex-shrink-0 border border-transparent hover:border-[#E3DCD7] dark:hover:border-[#514D48]" title="Attach File or Media">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </a>
            <div class="flex-1 bg-[#F8F6F3] dark:bg-[#45423E] border border-[#E3DCD7] dark:border-[#514D48] rounded-lg flex items-center px-3 py-1 focus-within:border-[#B3929D] focus-within:ring-1 focus-within:ring-[#B3929D] transition-all">
                <textarea id="message-content-input" maxlength="4000" rows="1" aria-label="Write a message" class="w-full bg-transparent text-xs font-medium text-[#2B2725] dark:text-[#F0E9E2] placeholder-[#6E6560] dark:placeholder-[#C9C0B9] focus:outline-none resize-none py-1 max-h-32" placeholder="Write a message..."></textarea>
                <button type="button" class="p-1 text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] transition-colors rounded-lg flex-shrink-0" title="Add Emoji">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                </button>
            </div>
            <a asp-controller="Chat" asp-action="VoiceRecording" class="w-9 h-9 rounded-lg flex items-center justify-center text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors flex-shrink-0 border border-transparent hover:border-[#E3DCD7] dark:hover:border-[#514D48]" title="Record Voice Message">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </a>
            <button id="send-message-btn" type="button" class="w-9 h-9 rounded-lg bg-[#B3929D] text-white flex items-center justify-center hover:opacity-95 active:scale-95 transition-all shadow-2xs flex-shrink-0 disabled:opacity-50 disabled:cursor-not-allowed" title="Send Message">
                <svg class="w-4 h-4 translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
            </button>
        </div>
        <div class="text-center pb-2">
            <span class="text-[10px] text-[#6E6560] dark:text-[#C9C0B9] font-medium">Press <kbd class="px-1.5 py-0.5 text-[10px] bg-[#F0E9DF] dark:bg-[#45423E] rounded border border-[#E3DCD7] dark:border-[#514D48]">Return</kbd> to send, <kbd class="px-1.5 py-0.5 text-[10px] bg-[#F0E9DF] dark:bg-[#45423E] rounded border border-[#E3DCD7] dark:border-[#514D48]">Shift + Return</kbd> for new line</span>
        </div>
    </div>

    <!-- Hidden Anti-Forgery Token Form for Fetch Requests -->
    <form id="antiForgeryForm" class="hidden">
        @Html.AntiForgeryToken()
    </form>

    <!-- Hidden MVC Form Fallback -->
    <form id="message-fallback-form" method="post" asp-controller="Chat" asp-action="SendMessage" class="hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="conversationId" value="@Model.Conversation.Id.Value" />
        <input type="hidden" name="content" id="fallback-content" />
        <input type="hidden" name="replyToMessageId" id="fallback-reply-to" />
        <input type="hidden" name="idempotencyKey" id="fallback-idempotency-key" />
    </form>

    <!-- Floating Emoji Reaction Picker Popover (clamped inside viewport) -->
    <div id="reaction-picker-popover" role="menu" aria-label="Add reaction" class="hidden fixed z-50 flex items-center gap-1 bg-white dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] rounded-full shadow-lg px-2 py-1 select-none max-w-[calc(100vw-16px)]">
        <button type="button" data-emoji-btn="👍" class="emoji-picker-btn w-7 h-7 flex items-center justify-center text-sm rounded-full hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] cursor-pointer" title="Thumbs Up">👍</button>
        <button type="button" data-emoji-btn="❤️" class="emoji-picker-btn w-7 h-7 flex items-center justify-center text-sm rounded-full hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] cursor-pointer" title="Heart">❤️</button>
        <button type="button" data-emoji-btn="😂" class="emoji-picker-btn w-7 h-7 flex items-center justify-center text-sm rounded-full hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] cursor-pointer" title="Joy">😂</button>
        <button type="button" data-emoji-btn="😮" class="emoji-picker-btn w-7 h-7 flex items-center justify-center text-sm rounded-full hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] cursor-pointer" title="Open Mouth">😮</button>
        <button type="button" data-emoji-btn="😢" class="emoji-picker-btn w-7 h-7 flex items-center justify-center text-sm rounded-full hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] cursor-pointer" title="Cry">😢</button>
        <button type="button" data-emoji-btn="🙏" class="emoji-picker-btn w-7 h-7 flex items-center justify-center text-sm rounded-full hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] cursor-pointer" title="Pray">🙏</button>
        <button type="button" data-emoji-btn="🔥" class="emoji-picker-btn w-7 h-7 flex items-center justify-center text-sm rounded-full hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] cursor-pointer" title="Fire">🔥</button>
        <button type="button" data-emoji-btn="🎉" class="emoji-picker-btn w-7 h-7 flex items-center justify-center text-sm rounded-full hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] cursor-pointer" title="Party">🎉</button>
    </div>

    <!-- Edit Message Accessible Modal -->
    <div id="edit-message-modal" role="dialog" aria-modal="true" aria-labelledby="edit-message-modal-title" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 backdrop-blur-xs">
        <div class="bg-white dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] rounded-2xl shadow-xl w-full max-w-md p-4 sm:p-5 flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <h3 id="edit-message-modal-title" class="text-sm font-bold text-[#2B2725] dark:text-[#F0E9E2]">Edit message</h3>
                <span class="text-xs text-[#6E6560] dark:text-[#C9C0B9]">Max 4000 characters</span>
            </div>
            <p id="edit-message-error" role="alert" class="hidden text-xs text-red-600 dark:text-red-400 font-medium"></p>
            <textarea id="edit-message-input" rows="4" maxlength="4000" aria-label="Edit message content" class="w-full bg-[#F8F6F3] dark:bg-[#302F2C] border border-[#E3DCD7] dark:border-[#514D48] rounded-xl p-3 text-xs text-[#2B2725] dark:text-[#F0E9E2] focus:outline-none focus:border-[#B3929D] focus:ring-1 focus:ring-[#B3929D] resize-none" placeholder="Enter updated text..."></textarea>
            <div class="flex items-center justify-end gap-2 pt-1">
                <button type="button" id="cancel-edit-btn" class="px-3.5 py-1.5 rounded-xl border border-[#E3DCD7] dark:border-[#514D48] text-xs font-semibold text-[#6E6560] dark:text-[#C9C0B9] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">Cancel</button>
                <button type="button" id="save-edit-btn" class="px-4 py-1.5 rounded-xl bg-[#B3929D] text-white text-xs font-bold hover:opacity-90 active:scale-95 transition-all shadow-2xs cursor-pointer">Save Changes</button>
            </div>
        </div>
    </div>

    <!-- Delete Message Accessible Confirmation Modal -->
    <div id="delete-message-modal" role="dialog" aria-modal="true" aria-labelledby="delete-message-modal-title" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 backdrop-blur-xs">
        <div class="bg-white dark:bg-[#3A3835] border border-[#E3DCD7] dark:border-[#514D48] rounded-2xl shadow-xl w-full max-w-sm p-4 sm:p-5 flex flex-col gap-3">
            <h3 id="delete-message-modal-title" class="text-sm font-bold text-[#2B2725] dark:text-[#F0E9E2]">Delete message?</h3>
            <p class="text-xs text-[#6E6560] dark:text-[#C9C0B9]">Choose whether to hide this message for yourself or delete it for everyone in the conversation.</p>
            <p id="delete-message-error" role="alert" class="hidden text-xs text-red-600 dark:text-red-400 font-medium"></p>
            <div class="flex flex-col gap-2 pt-2">
                <button type="button" id="delete-for-everyone-btn" class="w-full px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold transition-colors cursor-pointer">Delete for everyone</button>
                <button type="button" id="delete-for-me-btn" class="w-full px-4 py-2 rounded-xl border border-[#E3DCD7] dark:border-[#514D48] text-xs font-semibold text-[#2B2725] dark:text-[#F0E9E2] hover:bg-[#F0E9DF] dark:hover:bg-[#45423E] transition-colors cursor-pointer">Delete for me</button>
                <button type="button" id="cancel-delete-btn" class="w-full px-4 py-1.5 rounded-xl text-xs font-medium text-[#6E6560] dark:text-[#C9C0B9] hover:text-[#2B2725] dark:hover:text-[#F0E9E2] transition-colors cursor-pointer">Cancel</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/chat-realtime.js" asp-append-version="true"></script>
    <script type="module" src="~/js/chat-actions.js" asp-append-version="true"></script>
    <script type="module" src="~/js/conversation-page.js" asp-append-version="true"></script>
    <!-- ChatRealtime.init({ conversationId: conversationId, currentUserId: currentUserId, initialCursor: nextCursor }) initialized in conversation-page.js -->
}
