@model AOS.Messenger.Web.Controllers.ConfirmRecoveryViewModel
@{
    ViewData["Title"] = "Account Recovery Confirmation";
}

<div class="w-full flex-1 min-h-[calc(100vh-140px)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full text-center space-y-6 bg-surface-lowest dark:bg-[#1E1F23] p-8 rounded-2xl border border-outline-variant/30 shadow-xl">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-300 mb-2">
            <span class="material-symbols-outlined text-3xl">restore_from_trash</span>
        </div>
        <h2 class="text-2xl font-bold font-headline text-on-surface dark:text-white">Confirm Account Recovery</h2>
        <p class="text-sm text-secondary dark:text-gray-400">Click the button below to restore your account. Once restored, you can log in with your existing credentials.</p>
        <form asp-action="ConfirmRecovery" method="post" class="pt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />
            <button type="submit" class="py-2.5 px-6 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-sm font-semibold transition-all inline-block shadow-md cursor-pointer">
                Restore Account
            </button>
        </form>
    </div>
</div>
